-- ANTI LAG MAX / BOOST EXTREME MODIFICADO
local function AntiLagMax()
	task.spawn(function()
		-- Desativar luzes e efeitos pesados
		pcall(function()
			Lighting.GlobalShadows = false
			Lighting.Brightness = 0
			Lighting.FogEnd = 9e9
		end)

		-- Remover efeitos visuais
		for _,v in ipairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") then
				v:Destroy()
			end
		end

		for i,v in ipairs(workspace:GetDescendants()) do
			pcall(function()
				if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
					v:Destroy()
				end
				if v:IsA("Decal") or v:IsA("Texture") then
					v:Destroy()
				end
				if v:IsA("BasePart") then
					v.Material = Enum.Material.SmoothPlastic
					v.CastShadow = false
					v.Reflectance = 0
				end
				-- Desativar colisões de partes complexas
				if v:IsA("UnionOperation") or v:IsA("WedgePart") then
					v.CanCollide = false
				end
				-- Remover sons
				if v:IsA("Sound") then
					v:Destroy()
				end

				if i % 500 == 0 then
					task.wait()
				end
			end)
		end

		-- Cabeças dos jogadores invisíveis e leves
		for _, plr in ipairs(game.Players:GetPlayers()) do
			if plr.Character then
				local head = plr.Character:FindFirstChild("Head")
				if head then
					-- Remover SpecialMesh
					for _,m in ipairs(head:GetChildren()) do
						if m:IsA("SpecialMesh") then
							m:Destroy()
						end
					end

					-- Tornar cabeça invisível mas funcional
					head.Transparency = 1
					head.Material = Enum.Material.SmoothPlastic
					head.MeshId = ""
					head.TextureID = ""
					head.Size = Vector3.new(2,1,1)
				end
			end
		end

		-- Desativar decoração do terreno
		if Terrain then
			Terrain.Decoration = false
		end
	end)
end

-- BUTTON
local function createButton(text,x,y)
	local button = Instance.new("TextButton")
	button.Parent = main
	button.Position = UDim2.new(0,x,0,y)
	button.Size = UDim2.new(0,200,0,35)
	button.BackgroundColor3 = Color3.fromRGB(25,25,30)
	button.Text = ""

	Instance.new("UICorner",button).CornerRadius = UDim.new(0,8)

	local stroke = Instance.new("UIStroke",button)
	stroke.Color = Color3.fromRGB(0,255,120)
	stroke.Thickness = 1.5
	stroke.Transparency = 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

	local label = Instance.new("TextLabel")
	label.Parent = button
	label.Text = text
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1,-20,1,0)
	label.Position = UDim2.new(0,10,0,0)
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(0,255,120)
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left

	button.MouseButton1Click:Connect(function()
		if text == "ANTI LAG MAX" or text == "ANTI LAG LEVE" then
			AntiLagMax()
		elseif text == "SPEED PLAYER" then
			if player.Character and player.Character:FindFirstChild("Humanoid") then
				player.Character.Humanoid.WalkSpeed = 50
			end
		elseif text == "INFINITE JUMP" then
			UIS.JumpRequest:Connect(function()
				player.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end)
		elseif text == "NOCLIP" then
			noclip = not noclip
		end
	end)
end

